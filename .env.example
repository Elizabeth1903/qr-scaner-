# Copia este archivo como ".env" y cambia los valores por unos tuyos.
# NUNCA subas el .env real a internet ni lo compartas.

# Clave que firma los QR (ponla larga y aleatoria)
QR_SECRET=pon-aqui-una-clave-larga-y-secreta

# Clave para el panel de admin (solo tú)
ADMIN_KEY=cambia-esta-admin

# Clave para el personal de la puerta
DOOR_KEY=cambia-esta-puerta

# Puerto (opcional, por defecto 3000)
PORT=3000

# Ruta del archivo de base de datos (opcional)
DB_PATH=fiesta.db
